# ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic, NO scopes needed for public data)
# Create at: https://github.com/settings/tokens
# Without a token: 60 requests/hour · With a token: 5,000/hour
# ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_pat_here

# ──────────────────────────────────────────────────────────────
# OpenAI API key — required for the AI summary (Day 12+)
# Create at: https://platform.openai.com/api-keys
# Default model is gpt-4o-mini (cheap, fast, ~$0.0001 per analysis)
# ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_key_here

# Optional: override the default model
# OPENAI_MODEL=gpt-4o

# ──────────────────────────────────────────────────────────────
# Optional: target market region (default: UK)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_TARGET_MARKET=UK
