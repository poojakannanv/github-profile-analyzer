# ──────────────────────────────────────────────────────────────
# GitHub Personal Access Token (classic, NO scopes needed for public data)
# Create at: https://github.com/settings/tokens
# Without a token: 60 requests/hour · With a token: 5,000/hour
# ──────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_pat_here

# ──────────────────────────────────────────────────────────────
# AI provider — pick ONE setup (A or B). The client is OpenAI-compatible.
# ──────────────────────────────────────────────────────────────

# ── (A) OpenAI ────────────────────────────────────────────────
# Create key: https://platform.openai.com/api-keys · Requires $5 prepaid
# OPENAI_API_KEY=sk-proj-your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# ── (B) Groq (FREE, fast, recommended) ────────────────────────
# Create key: https://console.groq.com/keys · No credit card required
# Free tier: ~30 req/min · Excellent quality (Llama 3.3 70B)
OPENAI_API_KEY=gsk_your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ── Other compatible providers (uncomment + adapt) ────────────
# Together AI:
# OPENAI_BASE_URL=https://api.together.xyz/v1
# OPENAI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# Local model via LM Studio:
# OPENAI_API_KEY=lm-studio
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=local-model

# ──────────────────────────────────────────────────────────────
# Optional: target market region (default: UK)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_TARGET_MARKET=UK
